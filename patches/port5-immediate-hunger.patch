+	/** Removes an immediate, visible amount of food for a successful Ultimine use. */
+	private static void chargeImmediateFood(EntityPlayerMP player, int foodPoints)
+	{
+		if (foodPoints <= 0)
+		{
+			return;
+		}
+
+		FoodStats stats = player.getFoodStats();
+		int newFoodLevel = Math.max(0, stats.getFoodLevel() - foodPoints);
+		stats.setFoodLevel(newFoodLevel);
+
+		// Keep vanilla's invariant: saturation cannot exceed the food level.
+		if (stats.getSaturationLevel() > newFoodLevel)
+		{
+			stats.setFoodSaturationLevel(newFoodLevel);
+		}
+	}
